# Copy to .env and fill in ONE of the options below.
# .env is gitignored — the key never reaches the repo.

# ── Option 1: z.ai (GLM) ─────────────────────────────────────────────
# Key from https://z.ai. glm-4.7-flash and glm-4.5-flash are FREE — they
# need no balance. Paid slugs (glm-4.6, glm-5.x, …) bill pay-as-you-go
# and fail with error 1113 until the account is recharged.
# Free pools can answer 429 "1305 overloaded" under load — the harness
# retries automatically; if persistent, switch to the other free slug.
# AGENT_API_BASE=https://api.z.ai/api/paas/v4
# AGENT_API_KEY=
# AGENT_MODEL=glm-4.7-flash
# Optional: per-attempt timeout in ms (default 120000 — free pools queue long)
# AGENT_TIMEOUT_MS=120000

# ── Option 2: OpenRouter (default) ───────────────────────────────────
# Key from https://openrouter.ai/keys — one key, hundreds of models.
# OPENROUTER_API_KEY=
# Optional: any OpenRouter model slug (defaults to a free model)
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
